# ── credentials ─────────────────────────────────────────────────────────────
FASIH_USERNAME=username_sso_anda
FASIH_PASSWORD=password_sso_anda

# ── browser ─────────────────────────────────────────────────────────────────
HEADLESS=true                       # set false biar liat proses login
DEBUG=true                          # simpan screenshot tiap langkah

# ── SSO ─────────────────────────────────────────────────────────────────────
# FASIH_URL=https://fasih-sm.bps.go.id
# FASIH_SSO_BUTTON=Login SSO BPS    # teks tombol SSO di halaman awal

# ── crawl ───────────────────────────────────────────────────────────────────
SURVEY_PERIOD_ID=fd68e454-ba45-4b85-8205-f3bf777ded24
SURVEY_ROLE_ID=6d7d919a-45e5-4779-bb87-2905b49fd31a
PAGE_SIZE=10                        # data per halaman
CONCURRENCY=5                       # request paralel maksimal
DELAY_MS=1000                       # delay antar batch (ms)
MAX_RETRIES=3                       # maksimal retry untuk halaman gagal
# OUTPUT=results/progress-pencacah.json

# ── filter kab/kota (opsional) ─────────────────────────────────────────────
# Kode kab/kota BPS, 2 digit (misal '04' = Mempawah, '71' = Pontianak).
# Pisahkan dengan koma untuk multiple. Kosongkan = semua kab/kota.
KABUPATEN_CODES=

# Level ringkasan wilayah: 5 = SLS (14-digit), 6 = Sub-SLS (16-digit)
REGION_SUMMARY_LEVEL=6

# ── Google Sheets Sync ──────────────────────────────────────────────────────
SYNC_TO_GOOGLE_SHEETS=true
GOOGLE_APPLICATION_CREDENTIALS=nama-file-key-google-cloud-anda.json
# Buka Google Sheet Anda, salin ID dari URL (antara /d/ dan /edit)
SPREADSHEET_ID=YOUR_SPREADSHEET_ID_HERE
SPREADSHEET_ANOMALI_ID=1iK-N0xVKViNbzTIc64qBOjESJFdcR9IEtv1RjMWN9b0
ALLOCATION_SPREADSHEET_ID=1JNwyb7TsPmSsGl3o1zNTSc-3wzFwIr_t3HPz_a1CVVQ
SPREADSHEET_RANGE=6100!A1
SPREADSHEET_DATATABLE_RANGE=Responden!A1
SPREADSHEET_SE2026_RANGE=SE2026!A1
SPREADSHEET_ANOMALI_USAHA_RANGE=Anomali Usaha!A1
SPREADSHEET_ANOMALI_KELUARGA_RANGE=Anomali Keluarga!A1
GDRIVE_FOLDER_ID=1NZx69XzV7hlxsRlpILGODLNvHgY4cfcK
SYNC_FROM_GDRIVE=true

# ── datatable crawl ─────────────────────────────────────────────────────────
# Filter kabupaten khusus untuk datatable responden (misal '04' = Mempawah).
# Kosongkan untuk mengikuti nilai KABUPATEN_CODES di atas.
DATATABLE_KABUPATEN_CODES=
# Batas maksimal baris yang ditarik PER SLS (batas API datatable)
# Kosongkan atau hapus untuk tanpa batasan. Default: 1000
DATATABLE_MAX_ROWS=1000
# Jumlah worker paralel untuk datatable crawl (3-5 optimal, >5 risiko WAF block)
DATATABLE_CONCURRENCY=5

# ── Scheduler ───────────────────────────────────────────────────────────────

# Sinkronisasi progres SQL Lab (Tab 6100) tiap 1 jam sekali
CRON_SQLLAB_SCHEDULE="0 * * * *"

# Sinkronisasi Capaian/Anomali Dashboard SE2026 sehari sekali (jam 06:05 WIB)
CRON_DASHBOARD_SCHEDULE="5 6 * * *"

# ── Scheduler Job Switches ──────────────────────────────────────────────────
# Tentukan mekanisme background mana saja yang diaktifkan (true/false)
ENABLE_KEEP_ALIVE=true
ENABLE_CRON_SQLLAB=true
ENABLE_CRON_DASHBOARD=true

# Penarikan Progress Rekap Petugas langsung via Fasih-SM API (Crawl)
ENABLE_CRON_CRAWL=false
CRON_CRAWL_SCHEDULE="0 6 * * *"

